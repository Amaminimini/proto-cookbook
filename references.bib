@article{Wasula:2002,
  author = {Wasula, Alicia C. and Bosart, Lance F. and LaPenta, Kenneth D.},
  title = {The Influence of Terrain on the Severe Weather Distribution across Interior Eastern New York and Western New England},
  journal = {Weather and Forecasting},
  year = {2002},
  volume = {17},
  number = {6},
  pages = {1277--1289},
  doi = {10.1175/1520-0434(2002)017<1277:TIOTOT>2.0.CO;2},
  url = {https://journals.ametsoc.org/view/journals/wefo/17/6/1520-0434_2002_017_1277_tiotot_2_0_co_2.xml},
  abstract = {Forecasters have long suspected that prominent mountain ranges and river valleys in eastern New York and western New England, including the Hudson and Mohawk River valleys and the Adirondack, Catskill, Green, and Berkshire Mountains, influence convective initiation and the distribution of severe weather. This study documents the climatology of severe weather in the region from 1950–98 and compares the spatial distribution of severe weather reports with cloud-to-ground lightning during severe weather days. Stratifying cases by 700-hPa flow direction (northwest versus southwest) reveals preferred areas for severe weather occurrence that correspond to wind–terrain interactions. The results highlight the importance of terrain-induced mesoscale effects in modulating severe storm patterns.}
}

@article{Lebel:2021,
  author = {Lebel, Luke J. and Tang, Brian H. and Lazear, Ross A.},
  title = {Examining Terrain Effects on an Upstate New York Tornado Event Utilizing a High-Resolution Model Simulation},
  journal = {Weather and Forecasting},
  year = {2021},
  volume = {36},
  number = {6},
  pages = {2057--2076},
  doi = {10.1175/WAF-D-21-0021.1},
  url = {https://www.atmos.albany.edu/facstaff/btang/papers/2021_Mechanicville_WAF.pdf},
  abstract = {The complex terrain near the intersection of the Mohawk and Hudson Valleys influences the evolution of severe convection in upstate New York. Using a high-resolution WRF simulation of the 31 May 1998 Mechanicville tornado event, this study shows that terrain-channeled flow produced a localized dryline-like boundary that enhanced low-level shear, moisture, and instability east of the feature. A simulated supercell intensified after crossing this boundary due to greater streamwise vorticity and buoyancy in its inflow. These findings demonstrate how terrain-induced mesoscale boundaries can locally enhance the threat for severe convection and tornadogenesis.}
}

